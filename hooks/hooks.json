{
  "description": "Blocks git commit / gh pr / gh issue commands that mention Claude, Anthropic, or AI-assistance attribution.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/check_attribution.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
